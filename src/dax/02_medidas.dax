// ===================================================================
// MEDIDAS DAX - StreamView Analytics (crear todas en la tabla _Medidas)
// Herramientas de tabla > Nueva medida > pegar UNA medida a la vez.
// Entre corchetes [ ] se indica la carpeta de visualización sugerida.
// ===================================================================


// ======================= [01 Catálogo] =============================

Total Contenidos =
COUNTROWS ( Contenido )
// Formato: Número entero, separador de miles

Total Películas =
CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[tipo] = "Película" ) )

Total Series =
CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[tipo] = "Serie" ) )

% Películas =
DIVIDE ( [Total Películas], [Total Contenidos] )
// Formato: Porcentaje, 1 decimal

% Series =
DIVIDE ( [Total Series], [Total Contenidos] )

Países Representados =
CALCULATE (
    DISTINCTCOUNT ( Puente_Pais[pais] ),
    KEEPFILTERS ( Puente_Pais[pais] <> "Sin información" )
)

Idiomas Disponibles =
DISTINCTCOUNT ( Contenido[language] )

Géneros =
CALCULATE (
    DISTINCTCOUNT ( Puente_Genero[genero] ),
    KEEPFILTERS ( Puente_Genero[genero] <> "Sin información" )
)

% Contenido No Inglés =
DIVIDE (
    CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[language] <> "en" ) ),
    [Total Contenidos]
)
// Mide la internacionalización del catálogo. Formato: Porcentaje 1 decimal

Participación en Catálogo =
DIVIDE (
    [Total Contenidos],
    CALCULATE ( [Total Contenidos], ALLSELECTED ( Puente_Genero ), ALLSELECTED ( Puente_Pais ), ALLSELECTED ( dim_Idioma ) )
)
// % que representa el género/país/idioma de la fila sobre el total filtrado


// ======================= [02 Popularidad] ==========================

Popularidad Promedio =
AVERAGE ( Contenido[popularity] )
// Formato: Decimal, 1 decimal. OJO: muy sesgada por outliers -> usar también la mediana

Popularidad Mediana =
MEDIAN ( Contenido[popularity] )

Popularidad Mediana Año Anterior =
CALCULATE ( [Popularidad Mediana], DATEADD ( Calendario[Fecha], -1, YEAR ) )

Var % Popularidad vs Año Anterior =
DIVIDE ( [Popularidad Mediana] - [Popularidad Mediana Año Anterior], [Popularidad Mediana Año Anterior] )
// Formato: Porcentaje 1 decimal


// ======================= [03 Valoración] ===========================

Calificación Promedio =
AVERAGE ( Contenido[valoracion] )
// Ignora títulos sin votos (valoracion = nulo). Formato: Decimal 2

Valoración Ponderada =
AVERAGE ( Contenido[valoracion_ponderada] )
// Usar en rankings de "mejor evaluados" (evita títulos con pocos votos)

Total Votos =
SUM ( Contenido[vote_count] )

Contenidos con Votos =
CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[vote_count] > 0 ) )

% Alta Valoración =
DIVIDE (
    CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[valoracion] >= 7 ) ),
    [Contenidos con Votos]
)
// % de títulos evaluados con nota >= 7. Formato: Porcentaje 1 decimal

% Sin Votos =
DIVIDE ( [Total Contenidos] - [Contenidos con Votos], [Total Contenidos] )

Contenidos Estrella =
CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[es_estrella] = TRUE () ) )
// Estrella = nota >= 7, >= 50 votos y popularidad >= mediana de su tipo

% Contenidos Estrella =
DIVIDE ( [Contenidos Estrella], [Total Contenidos] )


// ======================= [04 Financiero - sólo películas] =========

Películas con Datos Financieros =
CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[financiero_valido] = TRUE () ) )

Cobertura Financiera % =
DIVIDE ( [Películas con Datos Financieros], [Total Películas] )
// Qué % de las películas tiene budget y revenue válidos (transparencia, regla 9)

Presupuesto Total =
SUM ( Contenido[presupuesto_usd] )
// Formato: Moneda USD, mostrar en miles de millones (unidades: Mil millones)

Ingresos Totales =
SUM ( Contenido[ingresos_usd] )

Presupuesto Promedio =
AVERAGE ( Contenido[presupuesto_usd] )

Ingreso Promedio =
AVERAGE ( Contenido[ingresos_usd] )

Ganancia Bruta =
[Ingresos Totales] - [Presupuesto Total]

ROI Agregado =
DIVIDE ( [Ingresos Totales], [Presupuesto Total] )
// ROI aproximado del caso = Revenue / Budget. Formato: 0.00"x"

ROI Mediano =
MEDIAN ( Contenido[roi] )
// Más robusto que el promedio (hay ROI > 500x en películas de bajo presupuesto)

% Películas Rentables =
DIVIDE (
    CALCULATE ( [Total Contenidos], KEEPFILTERS ( Contenido[roi] > 1 ) ),
    [Películas con Datos Financieros]
)
// Rentable = ingresos > presupuesto

ROI Película =
IF ( HASONEVALUE ( Contenido[id_contenido] ), MAX ( Contenido[roi] ) )
// Para tablas Top ROI


// ======================= [04b Producción] ==========================

Títulos por Director =
COUNTROWS ( Puente_Director )
// Usar con Puente_Director[director] en el eje (Top N = 10 en el panel de filtros)

Títulos por Actor =
COUNTROWS ( Puente_Actor )


// ======================= [05 Textos dinámicos] =====================

Texto Alcance =
VAR _a1 = MIN ( Contenido[anio_estreno] )
VAR _a2 = MAX ( Contenido[anio_estreno] )
VAR _tipo =
    IF ( HASONEVALUE ( Contenido[tipo] ), VALUES ( Contenido[tipo] ) & "s", "Películas y series" )
RETURN
    "Alcance: " & _tipo & "  ·  Estreno " & _a1 & "–" & _a2 & "  ·  "
        & FORMAT ( [Total Contenidos], "#,0" ) & " títulos"
// Cumple la regla de negocio 7: período y alcance siempre visibles

Texto Alcance Financiero =
"Sólo películas con presupuesto e ingresos ≥ USD 10.000  ·  n = "
    & FORMAT ( [Películas con Datos Financieros], "#,0" )
    & " (" & FORMAT ( [Cobertura Financiera %], "0.0%" ) & " de las películas)"

Texto Género Líder =
VAR _t =
    TOPN ( 1,
        FILTER ( VALUES ( Puente_Genero[genero] ), Puente_Genero[genero] <> "Sin información" ),
        [Total Contenidos], DESC )
RETURN
    "Género con más títulos: " & CONCATENATEX ( _t, Puente_Genero[genero], ", " )

Título Detalle =
SELECTEDVALUE ( Contenido[title], "Seleccione un título" )


// ======================= [06 Formato condicional] ==================

Color Valoración =
VAR _v = [Calificación Promedio]
RETURN
    SWITCH ( TRUE (),
        ISBLANK ( _v ), "#B0B0B0",
        _v >= 7, "#1baf7a",
        _v >= 6, "#eda100",
        "#e34948"
    )
// Usar en Formato condicional > Color de fondo/fuente > Valor del campo
// (siempre acompañado del número, nunca sólo color)

Color ROI =
IF ( [ROI Mediano] >= 1, "#1baf7a", "#e34948" )
