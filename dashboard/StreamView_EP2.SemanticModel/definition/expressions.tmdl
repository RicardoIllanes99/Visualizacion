expression RutaDatos = "C:\Users\Administrador\Desktop\StreamView_Final\data\raw\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: c163ca35-e544-4c0e-87b6-e97d050e36b1

	annotation PBI_ResultType = Text

expression map_Generos =
